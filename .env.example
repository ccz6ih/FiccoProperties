# Copy to .env.local and fill in. .env.local is gitignored.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client. Used by admin/server actions only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (Resend — https://resend.com). Optional; the app runs
# without these (notifications just no-op until set).
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=craigcarda2@gmail.com          # where new-application/tour alerts go (comma-separated ok)
EMAIL_FROM=Ficco Properties <notifications@ficcoproperties.com>  # verified Resend sender

# Scheduled cron jobs (Vercel). Bearer token that protects /api/cron/* routes.
CRON_SECRET=your-cron-secret
OWNER_REPORT_EMAILS=craigcarda2@gmail.com   # owner rent-report recipients (comma-separated)

# Online payments (Stripe ACH). DORMANT until PAYMENTS_PROVIDER=stripe — the app
# uses a built-in mock until then, so nothing goes live by accident.
# See /admin/payment-setup for a live status + checklist, and docs/STRIPE_SETUP.md.
PAYMENTS_PROVIDER=mock                       # set to "stripe" to activate online payments
STRIPE_SECRET_KEY=                           # sk_test_… (test) / sk_live_… (live)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=          # pk_test_… / pk_live_…
STRIPE_WEBHOOK_SECRET=                       # whsec_… from the Stripe webhook endpoint
NEXT_PUBLIC_APP_URL=https://38thaveproperties.com  # used in emails + webhook URL
