# Copy to .env.local and fill in. .env.local is gitignored.
# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-only. Never expose to the client. Used by admin/server actions only.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Email notifications (Resend — https://resend.com). Optional; the app runs
# without these (notifications just no-op until set).
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=craigcarda2@gmail.com          # where new-application/tour alerts go (comma-separated ok)
EMAIL_FROM=Ficco Properties <notifications@ficcoproperties.com>  # verified Resend sender
